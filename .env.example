# n8n / PostgreSQL
POSTGRES_USER=n8n
POSTGRES_PASSWORD=change_me
POSTGRES_DB=n8n
N8N_ENCRYPTION_KEY=replace_with_a_long_random_key

# Local-AI-Gateway
# Docker n8n on Windows: http://host.docker.internal:4545/v1
# Local n8n process: http://127.0.0.1:4545/v1
AI_GATEWAY_BASE_URL=http://host.docker.internal:4545/v1
AI_GATEWAY_API_KEY=replace_with_gateway_key
AI_MODEL=local-main

# ORM-backed content store used by n8n (inside Docker network)
CONTENT_STORE_BASE_URL=http://content-store:8080
CONTENT_STORE_MIN_CONFIDENCE=0.70
CONTENT_STORE_MIN_QUALITY_SCORE=0.70
CONTENT_STORE_PROCESSING_MAX_ATTEMPTS=3
CONTENT_STORE_PROCESSING_RETRY_DELAY_SECONDS=300
CONTENT_STORE_PROCESSING_STALE_SECONDS=1800
CONTENT_STORE_FETCH_TIMEOUT_SECONDS=10
CONTENT_STORE_FETCH_MAX_BYTES=1500000
# Optional comma-separated allowlist; empty means any public HTTP/HTTPS host.
CONTENT_STORE_ALLOWED_SOURCE_HOSTS=

# Telegram Bot API
TELEGRAM_BOT_TOKEN=replace_with_bot_token
TELEGRAM_REVIEW_CHAT_ID=replace_with_review_chat_id
TELEGRAM_TARGET_CHANNEL_ID=replace_with_target_channel_id
TELEGRAM_MODERATOR_IDS=replace_with_allowed_user_id
TELEGRAM_STYLE_PROFILE=Експертний, короткий і практичний стиль для Telegram-аудиторії. Без клікбейту, з чіткими фактами та джерелом.

# RSS source for the first MVP; add more RSS nodes later.
NEWS_FEED_URL_1=https://hnrss.org/frontpage

# Timezone used by n8n schedules.
GENERIC_TIMEZONE=Europe/Kyiv
