    {
      "parameters": {
        "method": "POST",
        "url": "={{ 'https://api.telegram.org/bot' + $env.TELEGRAM_BOT_TOKEN + '/sendMessage' }}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ chat_id: $('Parse moderation command').item.json.reply_chat_id, text: '🗑 Кандидат #' + $('Parse moderation command').item.json.candidate_id + ' відхилено.' }) }}",
        "options": {
          "timeout": 30000
        }
      },
      "id": "c7c6f9e2-59d3-4ec1-ce6c-1d7e57c2b110",
      "name": "Confirm rejection",
