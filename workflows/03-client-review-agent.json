      "parameters": {
        "method": "GET",
        "url": "={{ ($env.CONTENT_STORE_BASE_URL || 'http://content-store:8080') + '/v1/clients/' + encodeURIComponent($json.client_id) + '/style-context' }}",
        "options": {
          "timeout": 30000
        }
      },
      "id": "c1d2e3f4-0001-4c01-9001-000000000005",
      "name": "Load client style context",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "continueOnFail": true,
      "position": [
        960,
        -160
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const request = $('Normalize review request').item.json || {};\nconst context = $json && !$json.error ? $json : {};\nconst style_context = { profile_text: String(context.profile_text || '').slice(0, 4000), rules: Array.isArray(context.rules) ? context.rules.slice(0, 20) : [], recent_edits: Array.isArray(context.recent_edits) ? context.recent_edits.slice(0, 8) : [], recent_rejections: Array.isArray(context.recent_rejections) ? context.recent_rejections.slice(0, 8) : [] };\nreturn { json: { ...request, style_context } };"
      },
      "id": "c1d2e3f4-0001-4c01-9001-000000000006",
      "name": "Prepare client review prompt",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1280,
        -160
      ]
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "={{ 'Ти — окремий AI-агент попередньої перевірки стилю клієнта маркетингової агенції. Проаналізуй draft та історію реальних правок/відхилень клієнта. Поверни ТІЛЬКИ валідний JSON з ключами: risk_level (рядок low, medium або high), confidence (число 0..1), likely_edits (масив коротких рядків), risk_flags (масив коротких рядків), summary (непорожній рядок). Не переписуй draft і не вигадуй правила. Прогнозуй лише правки, які підтверджуються історією. Якщо доказів мало, risk_level=low, confidence не вище 0.60, likely_edits порожній. Усі пояснення українською, офіційні назви технологій не перекладай.\\n\\nDraft:\\nЗаголовок: ' + $json.title + '\\nТекст: ' + $json.text + '\\n\\nІсторія стилю клієнта:\\n' + JSON.stringify($json.style_context || {}) }}",
        "hasOutputParser": false,
        "needsFallback": false,
        "batching": {
          "batchSize": 1,
          "delayBetweenBatches": 0
        }
      },
      "id": "c1d2e3f4-0001-4c01-9001-000000000007",
      "name": "AI: Predict client review",
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.7,
      "onError": "continueErrorOutput",
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 3000,
      "position": [
        1600,
        -160
      ]
    },
    {
      "parameters": {
        "model": {
          "__rl": true,
          "mode": "id",
          "value": "local-main"
        },
        "responsesApiEnabled": false,
        "options": {
          "temperature": 0.25,
          "maxTokens": 500,
          "timeout": 300000,
          "maxRetries": 1
        }
      },
      "id": "c1d2e3f4-0001-4c01-9001-000000000008",
      "name": "AI Model: Local-AI-Gateway STYLE REVIEW",
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi",
      "typeVersion": 1.2,
      "position": [
        1600,
        320
      ],
      "credentials": {
        "openAiApi": {
          "id": "WkDuJfnR3zNyOH3w",
          "name": "Local AI Gateway MAIN"
        }
      }
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const raw = typeof $json.text === 'string' ? $json.text.trim() : JSON.stringify($json);\nlet review = null;\ntry { review = JSON.parse(raw); } catch {}\nconst request = $('Prepare client review prompt').item.json || {};\nconst isString = value => typeof value === 'string' && value.trim().length > 0;\nconst valid = !!review && typeof review === 'object' && !Array.isArray(review) && ['low', 'medium', 'high'].includes(review.risk_level) && Number.isFinite(review.confidence) && review.confidence >= 0 && review.confidence <= 1 && Array.isArray(review.likely_edits) && review.likely_edits.every(isString) && Array.isArray(review.risk_flags) && review.risk_flags.every(isString) && isString(review.summary);\nconst value = review || { risk_level: 'low', confidence: 0, likely_edits: [], risk_flags: [], summary: '' };\nreturn { json: { ...request, ok: valid, review_error: valid ? '' : 'AI style review JSON is invalid', risk_level: value.risk_level, confidence: Number(value.confidence || 0), likely_edits: value.likely_edits, risk_flags: value.risk_flags, summary: value.summary, raw_review: raw.slice(0, 12000) } };"
      },
      "id": "c1d2e3f4-0001-4c01-9001-000000000009",
      "name": "Parse client review",
      "type": "n8n-nodes-base.code",
