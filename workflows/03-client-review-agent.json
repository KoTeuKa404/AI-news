      },
      "id": "c1d2e3f4-0001-4c01-9001-000000000001",
      "name": "Client review webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        0
      ],
      "webhookId": "3m-client-review-agent"
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const body = $json.body && typeof $json.body === 'object' ? $json.body : $json;\nconst client_id = String(body.client_id || '').trim();\nconst candidate_id = body.candidate_id ? Number(body.candidate_id) : null;\nconst title = String(body.title || body.draft_title || '').trim();\nconst text = String(body.text || body.draft_text || '').trim();\nconst valid = client_id.length > 0 && title.length > 0 && text.length > 0 && title.length <= 500 && text.length <= 12000;\nreturn { json: { client_id, candidate_id: Number.isFinite(candidate_id) ? candidate_id : null, title, text, valid, validation_error: valid ? '' : 'Потрібні client_id, title і text; title до 500, text до 12000 символів.' } };"
      },
      "id": "c1d2e3f4-0001-4c01-9001-000000000002",
      "name": "Normalize review request",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        320,
        0
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "valid-review-request",
              "leftValue": "={{ String($json.valid) }}",
              "rightValue": "true",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
